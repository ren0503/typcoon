# Application
APP_NAME=tycoon-backend
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tycoon
DB_USER=tycoon
DB_PASSWORD=local-development-only
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# AWS (no credentials required for local development)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_EC2_METADATA_DISABLED=true

# CORS (comma-separated absolute origins; empty denies all)
CORS_ALLOWED_ORIGINS=

# Authentication (dev = explicit allowlist, jwt = reserved for later auth feature)
AUTH_MODE=dev
AUTH_DEV_PRINCIPALS=system:dev-1:00000000-0000-0000-0000-000000000000
