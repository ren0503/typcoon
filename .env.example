# Application
APP_NAME=tycoon-backend
APP_ENV=development
LOG_LEVEL=debug

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tycoon
DB_USER=tycoon
DB_PASSWORD=local-development-only
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s

# AWS (no credentials required for local development)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_EC2_METADATA_DISABLED=true

# CORS (comma-separated absolute origins; empty denies all)
CORS_ALLOWED_ORIGINS=

# Authentication (dev = explicit allowlist, jwt = Firebase SSO + backend tokens)
AUTH_MODE=dev
AUTH_DEV_PRINCIPALS=system:dev-1:00000000-0000-0000-0000-000000000000
AUTH_TRUST_PROXY=false

# Firebase (required with AUTH_MODE=jwt; emulator allowed only in development/test)
AUTH_FIREBASE_PROJECT_ID=
AUTH_FIREBASE_CREDENTIALS_FILE=
FIREBASE_AUTH_EMULATOR_HOST=

# Backend-issued tokens (AUTH_ACCESS_TTL must not exceed 15m)
AUTH_TOKEN_ISSUER=http://localhost:8080
AUTH_TOKEN_AUDIENCE=tycoon-api
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_CLOCK_SKEW=60s

# Token signing (local = development only; production/staging require kms)
AUTH_SIGNING_MODE=local
AUTH_SIGNING_ACTIVE_KID=local-dev-1
AUTH_SIGNING_KMS_KEYS=
AUTH_SIGNING_LOCAL_KEY_FILE=
AUTH_SIGNING_LOCAL_KID=local-dev-1

# Authentication rate limiter (memory for development/test; redis for production/staging)
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
AUTH_RATE_LIMIT_REDIS_PREFIX=tycoon:auth:ratelimit:
AUTH_RATE_LIMIT_EXCHANGE_IP_PER_MIN=10
AUTH_RATE_LIMIT_EXCHANGE_IDENTITY_PER_MIN=30
AUTH_RATE_LIMIT_REFRESH_IP_PER_MIN=60
AUTH_RATE_LIMIT_REFRESH_SESSION_PER_MIN=30
AUTH_RATE_LIMIT_LINK_ACCOUNT_PER_MIN=10
AUTH_RATE_LIMIT_LOGOUT_ALL_ACCOUNT_PER_MIN=5
